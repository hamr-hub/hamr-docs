{
  "name": "hamr-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run sitemap",
    "lint": "eslint .",
    "preview": "vite preview",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "size-limit": [
    {
      "name": "main bundle (gzip)",
      "path": "dist/assets/index-*.js",
      "limit": "200 KB",
      "gzip": true
    },
    {
      "name": "vendor-motion (gzip)",
      "path": "dist/assets/vendor-motion-*.js",
      "limit": "60 KB",
      "gzip": true
    },
    {
      "name": "vendor-markdown (gzip)",
      "path": "dist/assets/vendor-markdown-*.js",
      "limit": "70 KB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@size-limit/file": "^13.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.12.0",
    "postcss": "^8.5.8",
    "size-limit": "^13.0.3",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
